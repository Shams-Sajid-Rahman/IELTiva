# Settings for a private beta server. Copy these onto the beta server's own environment. Never commit real values.
# This lists what must differ from .env.example. Everything else there still applies.
# A beta has its own database, Redis, storage and secrets, and never shares them with production.

NODE_ENV=production
# Always requires the beta list and publication approval, and refuses live payments at startup.
RELEASE_CHANNEL=beta

FRONTEND_URL=https://beta.example.com
API_BASE_URL=https://api-beta.example.com
NEXT_PUBLIC_API_URL=https://api-beta.example.com/api/v1
NEXT_PUBLIC_SITE_URL=https://beta.example.com
COOKIE_SECURE=true
# The number of proxies in front of the API. Rate limits depend on this being right.
TRUST_PROXY=1

DATABASE_URL=postgresql://USER:CHANGE_ME@HOST:5432/ieltiva_beta
REDIS_URL=rediss://USER:CHANGE_ME@HOST:6379

# Generate new secrets for this server. They must differ from every other server.
JWT_ACCESS_SECRET=CHANGE_ME
CSRF_SECRET=CHANGE_ME

# Sandbox keys only. The server won't start with live payments allowed.
PAYMENT_ALLOW_LIVE=false
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
AAMARPAY_STORE_ID=
AAMARPAY_SIGNATURE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_USER=ieltiva-beta-user
R2_BUCKET_CONTENT=ieltiva-beta-content

ANTHROPIC_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Set a daily limit before anyone uses the beta. Without one, spending has no platform limit.
AI_DAILY_SPEND_ALERT_USD=
AI_DAILY_SPEND_LIMIT_USD=
AI_USER_DAILY_TOKEN_LIMIT=200000

RESEND_API_KEY=
EMAIL_FROM=
