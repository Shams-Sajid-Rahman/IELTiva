# Copy to .env and fill in real values. Never commit .env.
# Optional integrations stay switched off until their values are set.
# Retention periods, regions, prices, AI task routes and band releases are stored in the database.

# ---------- General ----------
# Required. The API refuses to start without it. Production must use production.
NODE_ENV=development
PORT=5000
# Public address of the web app, used for the CORS allowlist and email links
FRONTEND_URL=http://localhost:3000
# Public address of the API, used for payment and OAuth callbacks
API_BASE_URL=http://localhost:5000
# Reverse proxies in front of the API, for correct client IPs. 0 in local development.
TRUST_PROXY=0
LOG_LEVEL=debug

# ---------- Web app (visible to browsers, never put secrets here) ----------
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SENTRY_DSN=
# Set to true at build time to include the internal design system page in a production build.
DESIGN_SYSTEM_ENABLED=false

# ---------- Regional defaults ----------
# Used only when a visitor has no region. Each region's settings are in the database.
DEFAULT_REGION_CODE=BD

# ---------- Database ----------
# URL-encode special characters in the password (e.g. @ becomes %40)
# Development, test and production each use their own database. Production sets these
# on the host, never in a file. .env.test, if present, overrides this file for tests.
# Port 5433 keeps IELTiva separate from any other PostgreSQL on 5432.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://ieltiva:CHANGE_ME@localhost:5433/ieltiva?schema=public
TEST_DATABASE_URL=postgresql://ieltiva:CHANGE_ME@localhost:5433/ieltiva_test?schema=public

# Needed for background jobs, the shared cache and limits that hold across servers. Without it, those features are off or per-server.
# ---------- Redis (jobs and rate limits) ----------
REDIS_URL=redis://localhost:6379

# ---------- Authentication ----------
# At least 32 random characters each, different per environment.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME
CSRF_SECRET=CHANGE_ME
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Empty on localhost. In production, the shared parent domain, such as .your-domain.com
COOKIE_DOMAIN=
# Must be true in production.
COOKIE_SECURE=false

# Google sign-in. Returns 503 until both are set. Authorized redirect URI:
# <API_BASE_URL>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# First administrator, used by the setup command in development.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ---------- AI service ----------
# AI features return 503 until the selected provider's key is set.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Application code selects a task. Tasks map to these tiers, so models change here or per task in admin.
AI_MODEL_DEFAULT=claude-sonnet-5-5
AI_MODEL_COMPLEX=claude-opus-5-5
AI_MODEL_LIGHT=claude-haiku-5-5
# Sends an alert when calculated daily AI spend passes this amount.
AI_DAILY_SPEND_ALERT_USD=20
# Optional. New AI work stops for the day past this amount. Leave empty for no limit.
AI_DAILY_SPEND_LIMIT_USD=
AI_TIMEOUT_SECONDS=300

# ---------- Speech (trial, then Release 2) ----------
# Speaking assessment returns 503 until both Azure values are set.
SPEECH_PROVIDER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_LANGUAGE=en-GB
# Path to ffmpeg. Leave as ffmpeg if it's on PATH.
FFMPEG_PATH=ffmpeg

# ---------- Cloudflare R2 ----------
# Uploads return 503 until these are set. Only the public bucket has a public address.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_CONTENT=ieltiva-content
R2_BUCKET_USER=ieltiva-user
R2_BUCKET_CALIBRATION=ieltiva-calibration
R2_BUCKET_PUBLIC=ieltiva-public
# CDN address for marketing images only
R2_PUBLIC_URL=
PRESIGNED_UPLOAD_SECONDS=600
PRESIGNED_PLAYBACK_SECONDS=900

# ---------- Payments ----------
# Register a free sandbox store at developer.sslcommerz.com. SSLCommerz stays off until both are set.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# Keep true for testing. false takes real money.
SSLCOMMERZ_SANDBOX=true

# ---------- Local file storage ----------
# Private profile photos in development only. Production stays off until cloud storage is added.
STORAGE_LOCAL_DIR=.local-storage

# ---------- Email ----------
# Without a key, development prints emails, including their links, to the API terminal and reports them
# as not delivered. Other environments log an error and report not delivered.
RESEND_API_KEY=
EMAIL_FROM=

# ---------- Monitoring ----------
SENTRY_DSN=

# ---- Payments (sandbox only) ----
# Gateways run against their test environments unless PAYMENT_ALLOW_LIVE is true. Do not set it to true yet.
# Merchant keys go here and never in the database. Leave a gateway blank to keep it switched off.
PAYMENT_ALLOW_LIVE=false
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
AAMARPAY_STORE_ID=
AAMARPAY_SIGNATURE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Limits and tuning ----
# Which models an administrator may choose, separated by commas. Empty means only the three configured above.
AI_ALLOWED_MODELS=
# One student's daily AI token ceiling. 0 switches it off.
AI_USER_DAILY_TOKEN_LIMIT=500000
# Database connections for each API or worker process.
DB_POOL_MAX=10

# ---- Release ----
# development, beta or production. See OPERATIONS_RUNBOOK.md and .env.beta.example.
RELEASE_CHANNEL=development

# ---- Google Gemini (to use it, also set AI_PROVIDER=gemini) ----
# Create the key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL_DEFAULT=gemini-3.6-flash
GEMINI_MODEL_COMPLEX=gemini-3.6-flash
GEMINI_MODEL_LIGHT=gemini-3.5-flash-lite
# True only with paid billing on the Google project. Beta and production servers refuse to start with Gemini unless it's true,
# because Google may use and read what's sent through the free plan.
GEMINI_PAID_TIER=false
