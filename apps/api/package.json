{
  "name": "@ieltiva/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @ieltiva/shared",
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run build -w @ieltiva/shared && prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "pretypecheck": "npm run build -w @ieltiva/shared && prisma generate",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build -w @ieltiva/shared && prisma generate",
    "test": "vitest run",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "pretest:db": "npm run build -w @ieltiva/shared && prisma generate",
    "test:db": "vitest run --config vitest.integration.config.ts",
    "db:seed": "prisma db seed",
    "admin:create": "tsx scripts/create-admin.ts",
    "exams:sample": "tsx scripts/seed-sample-exams.ts",
    "worker": "tsx src/worker.ts",
    "worker:start": "node dist/worker.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@google/genai": "2.32.0",
    "@ieltiva/shared": "0.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "bullmq": "6.5.4",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "ffmpeg-static": "5.3.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.15",
    "microsoft-cognitiveservices-speech-sdk": "1.53.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.14.0",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
