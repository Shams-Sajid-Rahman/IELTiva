model AssessmentPackage {
  id           String    @id @default(uuid(7)) @db.Uuid
  code         String
  regionCode   String    @default("GLOBAL") @map("region_code")
  name         String
  description  String?
  skill        Skill
  credits      Int
  validityDays Int?      @map("validity_days")
  currency     String    @db.Char(3)
  priceMinor   Int       @map("price_minor")
  isActive     Boolean   @default(true) @map("is_active")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  purchases    UserPurchase[]
  entitlements UserEntitlement[]

  @@unique([code, regionCode, currency])
  @@index([isActive, regionCode, skill])
  @@map("assessment_packages")
}

model PaymentGateway {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique
  name        String
  isEnabled   Boolean  @default(false) @map("is_enabled")
  isSandbox   Boolean  @default(true) @map("is_sandbox")
  regionCodes String[] @map("region_codes")
  currencies  String[]
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  transactions PaymentTransaction[]

  @@map("payment_gateways")
}

model UserPurchase {
  id                  String         @id @default(uuid(7)) @db.Uuid
  userId              String         @map("user_id") @db.Uuid
  practicePackageId   String?        @map("practice_package_id") @db.Uuid
  assessmentPackageId String?        @map("assessment_package_id") @db.Uuid
  status              PurchaseStatus @default(PENDING)
  currency            String         @db.Char(3)
  amountMinor         Int            @map("amount_minor")
  discountMinor       Int            @default(0) @map("discount_minor")
  packageSnapshot     Json           @map("package_snapshot")
  paidAt              DateTime?      @map("paid_at") @db.Timestamptz(3)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user              User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  practicePackage   PracticePackage?     @relation(fields: [practicePackageId], references: [id], onDelete: Restrict)
  assessmentPackage AssessmentPackage?   @relation(fields: [assessmentPackageId], references: [id], onDelete: Restrict)
  transactions      PaymentTransaction[]
  entitlements      UserEntitlement[]
  refunds           RefundRecord[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([practicePackageId])
  @@index([assessmentPackageId])
  @@index([status])
  @@map("user_purchases")
}

model PaymentTransaction {
  id                   String        @id @default(uuid(7)) @db.Uuid
  purchaseId           String        @map("purchase_id") @db.Uuid
  gatewayId            String        @map("gateway_id") @db.Uuid
  trackingId           String        @unique @map("tracking_id")
  idempotencyKey       String        @unique @map("idempotency_key")
  gatewayTransactionId String?       @map("gateway_transaction_id")
  gatewayValidationId  String?       @map("gateway_validation_id")
  status               PaymentStatus @default(PENDING)
  currency             String        @db.Char(3)
  amountMinor          Int           @map("amount_minor")
  rawResponse          Json?         @map("raw_response")
  succeededAt          DateTime?     @map("succeeded_at") @db.Timestamptz(3)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  purchase UserPurchase   @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  gateway  PaymentGateway @relation(fields: [gatewayId], references: [id], onDelete: Restrict)
  refunds  RefundRecord[]

  @@unique([gatewayId, gatewayTransactionId])
  @@index([purchaseId])
  @@index([status, createdAt])
  @@map("payment_transactions")
}

model UserEntitlement {
  id                  String            @id @default(uuid(7)) @db.Uuid
  userId              String            @map("user_id") @db.Uuid
  purchaseId          String?           @map("purchase_id") @db.Uuid
  practicePackageId   String?           @map("practice_package_id") @db.Uuid
  assessmentPackageId String?           @map("assessment_package_id") @db.Uuid
  featureKey          String            @map("feature_key")
  status              EntitlementStatus @default(ACTIVE)
  creditsGranted      Int?              @map("credits_granted")
  creditsUsed         Int               @default(0) @map("credits_used")
  creditsReserved     Int               @default(0) @map("credits_reserved")
  startsAt            DateTime          @default(now()) @map("starts_at") @db.Timestamptz(3)
  endsAt              DateTime?         @map("ends_at") @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchase          UserPurchase?      @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  practicePackage   PracticePackage?   @relation(fields: [practicePackageId], references: [id], onDelete: Restrict)
  assessmentPackage AssessmentPackage? @relation(fields: [assessmentPackageId], references: [id], onDelete: Restrict)

  @@unique([purchaseId, featureKey])
  @@index([userId, featureKey, status])
  @@index([endsAt])
  @@index([practicePackageId])
  @@index([assessmentPackageId])
  @@map("user_entitlements")
}

model RefundRecord {
  id              String       @id @default(uuid(7)) @db.Uuid
  purchaseId      String       @map("purchase_id") @db.Uuid
  transactionId   String       @map("transaction_id") @db.Uuid
  processedById   String?      @map("processed_by_id") @db.Uuid
  gatewayRefundId String?      @map("gateway_refund_id")
  status          RefundStatus @default(PENDING)
  currency        String       @db.Char(3)
  amountMinor     Int          @map("amount_minor")
  reason          String?
  completedAt     DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  purchase    UserPurchase       @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  transaction PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  processedBy User?              @relation(fields: [processedById], references: [id], onDelete: SetNull)

  @@unique([transactionId, gatewayRefundId])
  @@index([purchaseId])
  @@index([processedById])
  @@map("refund_records")
}

// ---------- G. Platform administration ----------

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address") @db.Inet
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id           String                @id @default(uuid(7)) @db.Uuid
  type         NotificationType
  title        String
  body         String
  link         String?
  audience     AnnouncementAudience?
  audienceRole String?               @map("audience_role")
  status       PublicationStatus     @default(PUBLISHED)
  publishedAt  DateTime?             @map("published_at") @db.Timestamptz(3)
  expiresAt    DateTime?             @map("expires_at") @db.Timestamptz(3)
  createdById  String?               @map("created_by_id") @db.Uuid
  dedupeKey    String?               @unique @map("dedupe_key")
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  recipients UserNotification[]
  createdBy  User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([createdById])
  @@index([status, createdAt])
  @@map("notifications")
}

model UserNotification {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  notificationId String    @map("notification_id") @db.Uuid
  readAt         DateTime? @map("read_at") @db.Timestamptz(3)
  dismissedAt    DateTime? @map("dismissed_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@index([userId, readAt])
  @@index([notificationId])
  @@map("user_notifications")
}

model PlatformSetting {
  key         String   @id
  value       Json
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_settings")
}

model ContentPublicationHistory {
  id            String             @id @default(uuid(7)) @db.Uuid
  examVersionId String?            @map("exam_version_id") @db.Uuid
  courseId      String?            @map("course_id") @db.Uuid
  moduleId      String?            @map("module_id") @db.Uuid
  actorId       String?            @map("actor_id") @db.Uuid
  action        PublicationAction
  fromStatus    PublicationStatus? @map("from_status")
  toStatus      PublicationStatus  @map("to_status")
  note          String?
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  examVersion    ExamVersion?    @relation(fields: [examVersionId], references: [id], onDelete: SetNull)
  learningModule LearningModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  course         Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  actor          User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([examVersionId])
  @@index([moduleId])
  @@index([courseId])
  @@index([actorId])
  @@map("content_publication_history")
}
