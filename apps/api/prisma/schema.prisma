generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Stable values ----------

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETION_PENDING
  DELETED
}

enum ExamType {
  ACADEMIC
  GENERAL_TRAINING
}

enum Skill {
  LISTENING
  READING
  WRITING
  SPEAKING
}

enum PublicationStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum ContentProvenance {
  ORIGINAL
  LICENSED
  AI_ASSISTED_REVIEWED
}

enum ResourceType {
  ARTICLE
  VIDEO
  AUDIO
  DOCUMENT
  EXERCISE
  EXTERNAL_LINK
  VOCABULARY
  GRAMMAR
  PRACTICE_GUIDANCE
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum AnnouncementAudience {
  ALL
  ROLE
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELED
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum QuestionType {
  MULTIPLE_CHOICE_SINGLE
  MULTIPLE_CHOICE_MULTI
  TRUE_FALSE_NOT_GIVEN
  YES_NO_NOT_GIVEN
  MATCHING_GENERAL
  MATCHING_HEADINGS
  MATCHING_INFORMATION
  MATCHING_FEATURES
  MATCHING_SENTENCE_ENDINGS
  SENTENCE_COMPLETION
  SUMMARY_COMPLETION
  NOTE_COMPLETION
  TABLE_COMPLETION
  FLOW_CHART_COMPLETION
  FORM_COMPLETION
  DIAGRAM_LABELLING
  PLAN_LABELLING
  MAP_LABELLING
  SHORT_ANSWER
}

enum WritingTaskType {
  ACADEMIC_TASK_1
  GENERAL_TASK_1
  TASK_2
}

enum SpeakingPart {
  PART_1
  PART_2
  PART_3
}

enum AttemptMode {
  PRACTICE
  TIMED
  MOCK
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  ABANDONED
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AssessmentCriterion {
  TASK_ACHIEVEMENT
  TASK_RESPONSE
  COHERENCE_COHESION
  LEXICAL_RESOURCE
  GRAMMATICAL_RANGE_ACCURACY
  FLUENCY_COHERENCE
  PRONUNCIATION
}

enum FeedbackType {
  SUMMARY
  STRENGTH
  IMPROVEMENT
  CORRECTION
  PRONUNCIATION
}

enum BandVisibility {
  HIDDEN
  INTERNAL
  PUBLIC
}

enum AITier {
  DEFAULT
  COMPLEX
  LIGHT
}

enum CalibrationRecordType {
  HUMAN_MARK
  ADJUDICATION
  AI_PREDICTION
}

enum CalibrationSplit {
  TUNING
  VALIDATION
  TEST
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

enum EntitlementStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  REVOKED
}

enum NotificationType {
  SYSTEM
  LEARNING
  ASSESSMENT
  PAYMENT
  SECURITY
  ANNOUNCEMENT
}

enum PublicationAction {
  SUBMITTED_FOR_REVIEW
  PUBLISHED
  ARCHIVED
  RESTORED_TO_DRAFT
  CONTENT_UPDATED
}

// ---------- Foundation ----------

model AppMetadata {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("app_metadata")
}

// ---------- A. User management ----------

model User {
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until") @db.Timestamptz(3)
  termsAcceptedAt     DateTime?  @map("terms_accepted_at") @db.Timestamptz(3)
  id                  String     @id @default(uuid(7)) @db.Uuid
  email               String     @unique
  passwordHash        String?    @map("password_hash")
  status              UserStatus @default(ACTIVE)
  emailVerifiedAt     DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(3)
  deletionRequestedAt DateTime?  @map("deletion_requested_at") @db.Timestamptz(3)
  deletionScheduledAt DateTime?  @map("deletion_scheduled_at") @db.Timestamptz(3)
  deletedAt           DateTime?  @map("deleted_at") @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile                 UserProfile?
  userRoles               UserRole[]                    @relation("RoleHolder")
  rolesAssigned           UserRole[]                    @relation("RoleAssigner")
  sessions                UserSession[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  oauthAccounts           OAuthAccount[]
  enrollments             UserEnrollment[]
  learningProgress        LearningProgress[]
  studyPlans              StudyPlan[]
  learningHistory         UserLearningHistory[]
  examVersionsCreated     ExamVersion[]                 @relation("ExamVersionCreator")
  examVersionsReviewed    ExamVersion[]                 @relation("ExamVersionReviewer")
  examAttempts            ExamAttempt[]
  assessmentsReviewed     AssessmentResult[]
  instructorApprovals     AIModelConfiguration[]        @relation("InstructorApproval")
  ownerApprovals          AIModelConfiguration[]        @relation("OwnerApproval")
  aiJobs                  AIAssessmentJob[]
  aiUsageLogs             AIUsageLog[]
  calibrationMarks        AssessmentCalibrationRecord[]
  purchases               UserPurchase[]
  entitlements            UserEntitlement[]
  refundsProcessed        RefundRecord[]
  auditLogs               AuditLog[]
  notifications           UserNotification[]
  publicationActions      ContentPublicationHistory[]
  coursesTaught           Course[]
  announcementsCreated    Notification[]

  @@index([status])
  @@index([deletionScheduledAt])
  @@map("users")
}

model UserProfile {
  userId            String    @id @map("user_id") @db.Uuid
  firstName         String    @map("first_name")
  lastName          String    @map("last_name")
  avatarStorageKey  String?   @map("avatar_storage_key")
  countryCode       String?   @map("country_code") @db.Char(2)
  locale            String    @default("en")
  timezone          String    @default("UTC")
  examType          ExamType? @map("exam_type")
  targetBand        Decimal?  @map("target_band") @db.Decimal(2, 1)
  examDate          DateTime? @map("exam_date") @db.Date
  weeklyStudyHours  Int?      @map("weekly_study_hours")
  dailyGoalMinutes  Int?      @map("daily_goal_minutes")
  preferredSkills   Skill[]   @map("preferred_skills")
  notificationPrefs Json?     @map("notification_prefs")
  onboardedAt       DateTime? @map("onboarded_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedById String?  @map("assigned_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User  @relation("RoleHolder", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy User? @relation("RoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedById])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserSession {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address") @db.Inet
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  sessionId    String    @map("session_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  replacedById String?   @unique @map("replaced_by_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  session    UserSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("TokenRotation")

  @@index([userId])
  @@index([sessionId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  newEmail  String?   @map("new_email")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model OAuthAccount {
  id                String   @id @default(uuid(7)) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@map("oauth_accounts")
}

// ---------- B. Learning system ----------

model LearningModule {
  id               String            @id @default(uuid(7)) @db.Uuid
  code             String            @unique
  name             String
  description      String?
  skill            Skill?
  position         Int               @default(0)
  examType         ExamType?         @map("exam_type")
  difficulty       DifficultyLevel?
  estimatedMinutes Int?              @map("estimated_minutes")
  status           PublicationStatus @default(DRAFT)
  publishedAt      DateTime?         @map("published_at") @db.Timestamptz(3)
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  courses     Course[]
  publication ContentPublicationHistory[]

  @@map("learning_modules")
}

model Course {
  id                 String            @id @default(uuid(7)) @db.Uuid
  moduleId           String            @map("module_id") @db.Uuid
  slug               String            @unique
  title              String
  description        String?
  examType           ExamType?         @map("exam_type")
  status             PublicationStatus @default(DRAFT)
  provenance         ContentProvenance @default(ORIGINAL)
  isPremium          Boolean           @default(false) @map("is_premium")
  thumbnailUrl       String?           @map("thumbnail_url")
  difficulty         DifficultyLevel?
  learningObjectives String[]          @map("learning_objectives")
  estimatedMinutes   Int?              @map("estimated_minutes")
  instructorId       String?           @map("instructor_id") @db.Uuid
  publishedAt        DateTime?         @map("published_at") @db.Timestamptz(3)
  deletedAt          DateTime?         @map("deleted_at") @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  module      LearningModule              @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  instructor  User?                       @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  sections    CourseSection[]
  enrollments UserEnrollment[]
  history     UserLearningHistory[]
  publication ContentPublicationHistory[]

  @@index([moduleId, status])
  @@index([status, examType])
  @@index([instructorId])
  @@map("courses")
}

model CourseSection {
  id          String    @id @default(uuid(7)) @db.Uuid
  courseId    String    @map("course_id") @db.Uuid
  position    Int
  title       String
  description String?
  isVisible   Boolean   @default(true) @map("is_visible")
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  course    Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  resources LearningResource[]

  @@unique([courseId, position])
  @@map("course_sections")
}

model LearningResource {
  id              String       @id @default(uuid(7)) @db.Uuid
  sectionId       String       @map("section_id") @db.Uuid
  position        Int
  type            ResourceType
  title           String
  body            String?
  storageKey      String?      @map("storage_key")
  externalUrl     String?      @map("external_url")
  durationMinutes Int?         @map("duration_minutes")
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  section             CourseSection         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  progress            LearningProgress[]
  studyPlanTasks      StudyPlanTask[]
  enrollmentsLastHere UserEnrollment[]
  history             UserLearningHistory[]

  @@unique([sectionId, position])
  @@map("learning_resources")
}

model UserEnrollment {
  id             String           @id @default(uuid(7)) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  courseId       String           @map("course_id") @db.Uuid
  status         EnrollmentStatus @default(ACTIVE)
  completedAt    DateTime?        @map("completed_at") @db.Timestamptz(3)
  lastAccessedAt DateTime?        @map("last_accessed_at") @db.Timestamptz(3)
  lastResourceId String?          @map("last_resource_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course            @relation(fields: [courseId], references: [id], onDelete: Restrict)
  lastResource LearningResource? @relation(fields: [lastResourceId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([lastResourceId])
  @@index([status, createdAt])
  @@map("user_enrollments")
}

model LearningProgress {
  id             String         @id @default(uuid(7)) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  resourceId     String         @map("resource_id") @db.Uuid
  status         ProgressStatus @default(NOT_STARTED)
  percent        Int            @default(0)
  completedAt    DateTime?      @map("completed_at") @db.Timestamptz(3)
  lastAccessedAt DateTime?      @map("last_accessed_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource LearningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
  @@index([resourceId])
  @@map("learning_progress")
}

model StudyPlan {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  aiJobId    String?   @map("ai_job_id") @db.Uuid
  targetBand Decimal?  @map("target_band") @db.Decimal(2, 1)
  examDate   DateTime? @map("exam_date") @db.Date
  startsOn   DateTime  @map("starts_on") @db.Date
  endsOn     DateTime  @map("ends_on") @db.Date
  summary    String?
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiJob AIAssessmentJob? @relation(fields: [aiJobId], references: [id], onDelete: SetNull)
  tasks StudyPlanTask[]

  @@index([userId])
  @@index([aiJobId])
  @@map("study_plans")
}

model StudyPlanTask {
  id               String    @id @default(uuid(7)) @db.Uuid
  planId           String    @map("plan_id") @db.Uuid
  scheduledDate    DateTime  @map("scheduled_date") @db.Date
  skill            Skill?
  title            String
  description      String?
  estimatedMinutes Int?      @map("estimated_minutes")
  resourceId       String?   @map("resource_id") @db.Uuid
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan     StudyPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  resource LearningResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([planId, scheduledDate])
  @@index([resourceId])
  @@map("study_plan_tasks")
}

model UserLearningHistory {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  courseId   String?  @map("course_id") @db.Uuid
  resourceId String?  @map("resource_id") @db.Uuid
  eventType  String   @map("event_type")
  minutes    Int?
  metadata   Json?
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course?           @relation(fields: [courseId], references: [id], onDelete: SetNull)
  resource LearningResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt(sort: Desc)])
  @@index([courseId])
  @@index([resourceId])
  @@map("user_learning_history")
}

// ---------- C. Examination content ----------

model Exam {
  id        String    @id @default(uuid(7)) @db.Uuid
  slug      String    @unique
  title     String
  examType  ExamType? @map("exam_type")
  isPremium Boolean   @default(false) @map("is_premium")
  isMock    Boolean   @default(false) @map("is_mock")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  versions ExamVersion[]

  @@index([examType, isMock])
  @@map("exams")
}

model ExamVersion {
  id               String            @id @default(uuid(7)) @db.Uuid
  examId           String            @map("exam_id") @db.Uuid
  versionNumber    Int               @map("version_number")
  status           PublicationStatus @default(DRAFT)
  provenance       ContentProvenance @default(ORIGINAL)
  sourceNote       String?           @map("source_note")
  bandTableVersion String?           @map("band_table_version")
  createdById      String?           @map("created_by_id") @db.Uuid
  reviewedById     String?           @map("reviewed_by_id") @db.Uuid
  publishedAt      DateTime?         @map("published_at") @db.Timestamptz(3)
  archivedAt       DateTime?         @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  exam        Exam                        @relation(fields: [examId], references: [id], onDelete: Restrict)
  createdBy   User?                       @relation("ExamVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy  User?                       @relation("ExamVersionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  sections    ExamSection[]
  attempts    ExamAttempt[]
  publication ContentPublicationHistory[]

  @@unique([examId, versionNumber])
  @@index([status])
  @@index([createdById])
  @@index([reviewedById])
  @@map("exam_versions")
}

model ExamSection {
  id              String   @id @default(uuid(7)) @db.Uuid
  examVersionId   String   @map("exam_version_id") @db.Uuid
  position        Int
  skill           Skill
