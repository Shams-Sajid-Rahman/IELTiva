  instructions    String?
  durationSeconds Int      @map("duration_seconds")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  examVersion       ExamVersion        @relation(fields: [examVersionId], references: [id], onDelete: Cascade)
  questionGroups    QuestionGroup[]
  readingPassages   ReadingPassage[]
  listeningAudios   ListeningAudio[]
  writingTasks      WritingTask[]
  speakingQuestions SpeakingQuestion[]
  sectionAttempts   SectionAttempt[]

  @@unique([examVersionId, position])
  @@map("exam_sections")
}

model ReadingPassage {
  id        String   @id @default(uuid(7)) @db.Uuid
  sectionId String   @map("section_id") @db.Uuid
  position  Int
  title     String
  body      String
  wordCount Int      @map("word_count")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  section ExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, position])
  @@map("reading_passages")
}

model ListeningAudio {
  id              String   @id @default(uuid(7)) @db.Uuid
  sectionId       String   @map("section_id") @db.Uuid
  position        Int
  storageKey      String   @map("storage_key")
  durationSeconds Int      @map("duration_seconds")
  transcript      String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  section ExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, position])
  @@map("listening_audios")
}

model QuestionGroup {
  id              String       @id @default(uuid(7)) @db.Uuid
  sectionId       String       @map("section_id") @db.Uuid
  position        Int
  type            QuestionType
  instructions    String?
  stimulus        Json?
  imageStorageKey String?      @map("image_storage_key")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  section   ExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([sectionId, position])
  @@map("question_groups")
}

model Question {
  id          String   @id @default(uuid(7)) @db.Uuid
  groupId     String   @map("group_id") @db.Uuid
  number      Int
  prompt      String?
  explanation String?
  marks       Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  group     QuestionGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  options   QuestionOption[]
  answers   QuestionAnswer[]
  responses QuestionResponse[]

  @@unique([groupId, number])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(uuid(7)) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  position   Int
  label      String
  body       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position])
  @@unique([questionId, label])
  @@map("question_options")
}

model QuestionAnswer {
  id            String   @id @default(uuid(7)) @db.Uuid
  questionId    String   @map("question_id") @db.Uuid
  acceptedValue String   @map("accepted_value")
  caseSensitive Boolean  @default(false) @map("case_sensitive")
  maxWords      Int?     @map("max_words")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, acceptedValue])
  @@map("question_answers")
}

model WritingTask {
  id               String          @id @default(uuid(7)) @db.Uuid
  sectionId        String          @map("section_id") @db.Uuid
  position         Int
  taskType         WritingTaskType @map("task_type")
  prompt           String
  imageStorageKey  String?         @map("image_storage_key")
  minWords         Int             @map("min_words")
  suggestedMinutes Int             @map("suggested_minutes")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  section     ExamSection         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  submissions WritingSubmission[]

  @@unique([sectionId, position])
  @@map("writing_tasks")
}

model SpeakingQuestion {
  id               String       @id @default(uuid(7)) @db.Uuid
  sectionId        String       @map("section_id") @db.Uuid
  part             SpeakingPart
  position         Int
  prompt           String
  cueCard          Json?        @map("cue_card")
  audioStorageKey  String?      @map("audio_storage_key")
  prepSeconds      Int?         @map("prep_seconds")
  maxAnswerSeconds Int          @map("max_answer_seconds")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  section     ExamSection          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  submissions SpeakingSubmission[]

  @@unique([sectionId, part, position])
  @@map("speaking_questions")
}

// ---------- D. Examination attempts ----------

model ExamAttempt {
  id               String        @id @default(uuid(7)) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  examVersionId    String        @map("exam_version_id") @db.Uuid
  mode             AttemptMode
  status           AttemptStatus @default(IN_PROGRESS)
  bandTableVersion String?       @map("band_table_version")
  overallBand      Decimal?      @map("overall_band") @db.Decimal(2, 1)
  startedAt        DateTime      @default(now()) @map("started_at") @db.Timestamptz(3)
  expiresAt        DateTime?     @map("expires_at") @db.Timestamptz(3)
  submittedAt      DateTime?     @map("submitted_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  examVersion ExamVersion      @relation(fields: [examVersionId], references: [id], onDelete: Restrict)
  sections    SectionAttempt[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([examVersionId])
  @@index([status, expiresAt])
  @@map("exam_attempts")
}

model SectionAttempt {
  id               String        @id @default(uuid(7)) @db.Uuid
  examAttemptId    String        @map("exam_attempt_id") @db.Uuid
  sectionId        String        @map("section_id") @db.Uuid
  status           AttemptStatus @default(IN_PROGRESS)
  startedAt        DateTime?     @map("started_at") @db.Timestamptz(3)
  expiresAt        DateTime?     @map("expires_at") @db.Timestamptz(3)
  lastSavedAt      DateTime?     @map("last_saved_at") @db.Timestamptz(3)
  submittedAt      DateTime?     @map("submitted_at") @db.Timestamptz(3)
  timeSpentSeconds Int           @default(0) @map("time_spent_seconds")
  rawScore         Int?          @map("raw_score")
  bandScore        Decimal?      @map("band_score") @db.Decimal(2, 1)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  examAttempt         ExamAttempt          @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)
  section             ExamSection          @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  responses           QuestionResponse[]
  writingSubmissions  WritingSubmission[]
  speakingSubmissions SpeakingSubmission[]
  assessmentResults   AssessmentResult[]

  @@unique([examAttemptId, sectionId])
  @@index([sectionId])
  @@map("section_attempts")
}

model QuestionResponse {
  id               String    @id @default(uuid(7)) @db.Uuid
  sectionAttemptId String    @map("section_attempt_id") @db.Uuid
  questionId       String    @map("question_id") @db.Uuid
  response         Json?
  isCorrect        Boolean?  @map("is_correct")
  isFlagged        Boolean   @default(false) @map("is_flagged")
  answeredAt       DateTime? @map("answered_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sectionAttempt SectionAttempt @relation(fields: [sectionAttemptId], references: [id], onDelete: Cascade)
  question       Question       @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([sectionAttemptId, questionId])
  @@index([questionId])
  @@map("question_responses")
}

model WritingSubmission {
  id                 String           @id @default(uuid(7)) @db.Uuid
  sectionAttemptId   String           @map("section_attempt_id") @db.Uuid
  writingTaskId      String           @map("writing_task_id") @db.Uuid
  parentSubmissionId String?          @map("parent_submission_id") @db.Uuid
  text               String
  wordCount          Int              @default(0) @map("word_count")
  timeSpentSeconds   Int              @default(0) @map("time_spent_seconds")
  status             ProcessingStatus @default(PENDING)
  lastSavedAt        DateTime?        @map("last_saved_at") @db.Timestamptz(3)
  submittedAt        DateTime?        @map("submitted_at") @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  sectionAttempt SectionAttempt      @relation(fields: [sectionAttemptId], references: [id], onDelete: Cascade)
  writingTask    WritingTask         @relation(fields: [writingTaskId], references: [id], onDelete: Restrict)
  parent         WritingSubmission?  @relation("WritingRevision", fields: [parentSubmissionId], references: [id], onDelete: SetNull)
  revisions      WritingSubmission[] @relation("WritingRevision")
  results        AssessmentResult[]

  @@unique([sectionAttemptId, writingTaskId])
  @@index([writingTaskId])
  @@index([parentSubmissionId])
  @@map("writing_submissions")
}

model SpeakingSubmission {
  id                    String           @id @default(uuid(7)) @db.Uuid
  sectionAttemptId      String           @map("section_attempt_id") @db.Uuid
  speakingQuestionId    String           @map("speaking_question_id") @db.Uuid
  audioStorageKey       String?          @map("audio_storage_key")
  durationSeconds       Int?             @map("duration_seconds")
  transcript            String?
  wordTimings           Json?            @map("word_timings")
  fluencyMetrics        Json?            @map("fluency_metrics")
  pronunciationFeedback Json?            @map("pronunciation_feedback")
  status                ProcessingStatus @default(PENDING)
  audioDeleteAfter      DateTime?        @map("audio_delete_after") @db.Timestamptz(3)
  submittedAt           DateTime?        @map("submitted_at") @db.Timestamptz(3)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  sectionAttempt   SectionAttempt     @relation(fields: [sectionAttemptId], references: [id], onDelete: Cascade)
  speakingQuestion SpeakingQuestion   @relation(fields: [speakingQuestionId], references: [id], onDelete: Restrict)
  results          AssessmentResult[]

  @@unique([sectionAttemptId, speakingQuestionId])
  @@index([speakingQuestionId])
  @@index([audioDeleteAfter])
  @@map("speaking_submissions")
}

model AssessmentResult {
  id                   String         @id @default(uuid(7)) @db.Uuid
  writingSubmissionId  String?        @map("writing_submission_id") @db.Uuid
  speakingSubmissionId String?        @map("speaking_submission_id") @db.Uuid
  sectionAttemptId     String?        @map("section_attempt_id") @db.Uuid
  aiJobId              String?        @map("ai_job_id") @db.Uuid
  modelConfigurationId String?        @map("model_configuration_id") @db.Uuid
  promptVersionId      String?        @map("prompt_version_id") @db.Uuid
  providerSnapshot     String?        @map("provider_snapshot")
  modelSnapshot        String?        @map("model_snapshot")
  overallBand          Decimal?       @map("overall_band") @db.Decimal(2, 1)
  bandVisibility       BandVisibility @default(HIDDEN) @map("band_visibility")
  isCurrent            Boolean        @default(true) @map("is_current")
  reviewedById         String?        @map("reviewed_by_id") @db.Uuid
  reviewerNote         String?        @map("reviewer_note")
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  writingSubmission  WritingSubmission?    @relation(fields: [writingSubmissionId], references: [id], onDelete: Cascade)
  speakingSubmission SpeakingSubmission?   @relation(fields: [speakingSubmissionId], references: [id], onDelete: Cascade)
  sectionAttempt     SectionAttempt?       @relation(fields: [sectionAttemptId], references: [id], onDelete: Cascade)
  aiJob              AIAssessmentJob?      @relation(fields: [aiJobId], references: [id], onDelete: SetNull)
  modelConfiguration AIModelConfiguration? @relation(fields: [modelConfigurationId], references: [id], onDelete: SetNull)
  promptVersion      AIPromptVersion?      @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)
  reviewedBy         User?                 @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  feedback           AssessmentFeedback[]
  criterionScores    CriterionScore[]

  @@index([writingSubmissionId])
  @@index([speakingSubmissionId])
  @@index([sectionAttemptId])
  @@index([aiJobId])
  @@index([modelConfigurationId])
  @@index([promptVersionId])
  @@index([reviewedById])
  @@map("assessment_results")
}

model AssessmentFeedback {
  id        String       @id @default(uuid(7)) @db.Uuid
  resultId  String       @map("result_id") @db.Uuid
  type      FeedbackType
  position  Int
  body      String
  evidence  Json?
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  result AssessmentResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@unique([resultId, type, position])
  @@map("assessment_feedback")
}

model CriterionScore {
  id        String              @id @default(uuid(7)) @db.Uuid
  resultId  String              @map("result_id") @db.Uuid
  criterion AssessmentCriterion
  band      Decimal             @db.Decimal(2, 1)
  rationale String?
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  result AssessmentResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@unique([resultId, criterion])
  @@map("criterion_scores")
}

// ---------- E. AI assessment infrastructure ----------

model AIModelConfiguration {
  id                     String         @id @default(uuid(7)) @db.Uuid
  taskKey                String         @map("task_key")
  provider               String
  modelId                String         @map("model_id")
  tier                   AITier         @default(DEFAULT)
  effort                 String?
  parameters             Json?
  inputMicrousdPerMtok   BigInt?        @map("input_microusd_per_mtok")
  outputMicrousdPerMtok  BigInt?        @map("output_microusd_per_mtok")
  bandVisibility         BandVisibility @default(HIDDEN) @map("band_visibility")
  calibrationValidatedAt DateTime?      @map("calibration_validated_at") @db.Timestamptz(3)
  instructorApprovedById String?        @map("instructor_approved_by_id") @db.Uuid
  ownerApprovedById      String?        @map("owner_approved_by_id") @db.Uuid
  isActive               Boolean        @default(false) @map("is_active")
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  instructorApprovedBy User?                         @relation("InstructorApproval", fields: [instructorApprovedById], references: [id], onDelete: SetNull)
  ownerApprovedBy      User?                         @relation("OwnerApproval", fields: [ownerApprovedById], references: [id], onDelete: SetNull)
  results              AssessmentResult[]
  jobs                 AIAssessmentJob[]
  usageLogs            AIUsageLog[]
  calibrationRecords   AssessmentCalibrationRecord[]

  @@unique([taskKey, provider, modelId])
  @@index([instructorApprovedById])
  @@index([ownerApprovedById])
  @@map("ai_model_configurations")
}

model AIPromptVersion {
  id            String   @id @default(uuid(7)) @db.Uuid
  taskKey       String   @map("task_key")
  version       Int
  rubricVersion String?  @map("rubric_version")
  content       String
  isActive      Boolean  @default(false) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  results            AssessmentResult[]
  jobs               AIAssessmentJob[]
  calibrationRecords AssessmentCalibrationRecord[]

  @@unique([taskKey, version])
  @@map("ai_prompt_versions")
}

model AIAssessmentJob {
  id                   String           @id @default(uuid(7)) @db.Uuid
  userId               String?          @map("user_id") @db.Uuid
  taskKey              String           @map("task_key")
  subjectType          String           @map("subject_type")
  subjectId            String           @map("subject_id")
  modelConfigurationId String?          @map("model_configuration_id") @db.Uuid
  promptVersionId      String?          @map("prompt_version_id") @db.Uuid
  idempotencyKey       String           @unique @map("idempotency_key")
  status               ProcessingStatus @default(PENDING)
  attempts             Int              @default(0)
  errorCode            String?          @map("error_code")
  errorMessage         String?          @map("error_message")
  queuedAt             DateTime         @default(now()) @map("queued_at") @db.Timestamptz(3)
  startedAt            DateTime?        @map("started_at") @db.Timestamptz(3)
  finishedAt           DateTime?        @map("finished_at") @db.Timestamptz(3)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user               User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  modelConfiguration AIModelConfiguration? @relation(fields: [modelConfigurationId], references: [id], onDelete: SetNull)
  promptVersion      AIPromptVersion?      @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)
  results            AssessmentResult[]
  usageLogs          AIUsageLog[]
  studyPlans         StudyPlan[]

  @@index([status, queuedAt])
  @@index([userId, queuedAt(sort: Desc)])
  @@index([subjectType, subjectId])
  @@index([modelConfigurationId])
  @@index([promptVersionId])
  @@map("ai_assessment_jobs")
}

model AIUsageLog {
  id                   String   @id @default(uuid(7)) @db.Uuid
  userId               String?  @map("user_id") @db.Uuid
  jobId                String?  @map("job_id") @db.Uuid
  modelConfigurationId String?  @map("model_configuration_id") @db.Uuid
  taskKey              String   @map("task_key")
  provider             String
  modelId              String   @map("model_id")
  inputTokens          Int      @default(0) @map("input_tokens")
  outputTokens         Int      @default(0) @map("output_tokens")
  cacheReadTokens      Int      @default(0) @map("cache_read_tokens")
  cacheWriteTokens     Int      @default(0) @map("cache_write_tokens")
  isBatch              Boolean  @default(false) @map("is_batch")
  costMicrousd         BigInt?  @map("cost_microusd")
  latencyMs            Int?     @map("latency_ms")
  outcome              String
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user               User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  job                AIAssessmentJob?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  modelConfiguration AIModelConfiguration? @relation(fields: [modelConfigurationId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([taskKey, createdAt])
  @@index([userId, createdAt])
  @@index([jobId])
  @@index([modelConfigurationId])
  @@map("ai_usage_logs")
}

model AssessmentCalibrationRecord {
  id                   String                @id @default(uuid(7)) @db.Uuid
  sampleReference      String                @map("sample_reference")
  datasetVersion       String                @map("dataset_version")
  skill                Skill
  taskKey              String                @map("task_key")
  split                CalibrationSplit
  recordType           CalibrationRecordType @map("record_type")
  markerId             String?               @map("marker_id") @db.Uuid
  modelConfigurationId String?               @map("model_configuration_id") @db.Uuid
  promptVersionId      String?               @map("prompt_version_id") @db.Uuid
  responseText         String?               @map("response_text")
  audioStorageKey      String?               @map("audio_storage_key")
  consentVersion       String?               @map("consent_version")
  deidentifiedAt       DateTime?             @map("deidentified_at") @db.Timestamptz(3)
  overallBand          Decimal?              @map("overall_band") @db.Decimal(2, 1)
  criterionBands       Json?                 @map("criterion_bands")
  notes                String?
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  marker             User?                 @relation(fields: [markerId], references: [id], onDelete: SetNull)
  modelConfiguration AIModelConfiguration? @relation(fields: [modelConfigurationId], references: [id], onDelete: SetNull)
  promptVersion      AIPromptVersion?      @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

  @@index([datasetVersion, split])
  @@index([sampleReference])
  @@index([markerId])
  @@index([modelConfigurationId])
  @@index([promptVersionId])
  @@map("assessment_calibration_records")
}

// ---------- F. Payments and packages ----------

model PracticePackage {
